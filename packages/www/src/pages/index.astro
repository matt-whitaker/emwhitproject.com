---
import Layout from '../layouts/Layout.astro';
import { getExcerpt } from '../lib/excerpt.js';
import { getCollection } from 'astro:content';

const discography = (await getCollection('discography', ({ data }) => !data.exclude))
  .sort((a, b) => b.data.date - a.data.date);

const news = (await getCollection('news'))
  .sort((a, b) => b.data.date - a.data.date)
  .map(entry => ({ ...entry, preview: entry.data.preview ?? getExcerpt(entry.body) }));
---

<Layout>
  <div id="app">

    <!-- Hero -->
    <section id="hero" class="flex justify-center items-center w-vw h-vh">
      <h1 class="font-stardos text-red text-hero text-center">
        <span class="hero-word">The</span>
        <span class="hero-word"> Emwhit</span>
        <span class="hero-word"> Project</span>
      </h1>
    </section>

    <!-- About -->
    <section id="about" class="flex max-lg:flex-col items-center gap-16 py-24 px-[8vw] bg-white text-near-black">
    <!--<img
        class="about-img w-3/5 max-lg:w-full shrink-0 object-cover rounded"
        src="<%- config.images.about %>"
        alt="About photo"
      />-->
      <div class="about-text flex-1 text-lg leading-loose">
        <h2 class="font-stardos text-red text-4xl mb-2">About</h2>
        <p>
          The Emwhit Project is an independent music endeavor emerging from the mind of Matt Whitaker. Born from a
          desire to put his creative spirit out to the world, the project takes on a variety of rock genres suited to
          tell his stories. Self-taught, leveraging powerhouse vocals and a computer, each song is an iteration of his
          craft. The goal: authentic, from-the-soul musical narratives that resonate with people.
        </p>
      </div>
    </section>

    <!-- News -->
    <section id="news" class="py-24 px-[8vw] text-white">
      <h2 class="font-stardos text-red text-4xl mb-3">News</h2>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(18em,1fr))] gap-10">
        {news.map(({ id, data, preview }) => (
          <article class="news-item border-t-2 border-red pt-4">
            <time class="block text-xs opacity-60 mb-1.5">
              {data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
            </time>
            <h3 class="text-xl font-bold mb-2">
              <a href={`/news/${id}/`} class="hover:opacity-70 transition-opacity">{data.title}</a>
            </h3>
            <p class="text-base leading-body opacity-85">{preview}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- Discography -->
    <section id="discography" class="py-24 px-[8vw] text-white hidden">
      <h2 class="font-stardos text-red text-4xl mb-3">Discography</h2>
      <div class="flex flex-wrap gap-12">
        {discography.map(({ data }) => (
          <div class="disco-item flex items-start gap-8">
            <img class="disco-art w-48 h-48 object-cover rounded shrink-0" src={data.cover} alt={`${data.title} cover`} />
            <div class="flex flex-col gap-1.5">
              <h3 class="font-stardos text-2xl">{data.title}</h3>
              <span class="text-sm opacity-60">{data.type} &mdash; {data.date.getFullYear()}</span>
              <p class="mt-2 text-base leading-body max-w-2xl opacity-85">{data.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

  </div>

  <script>
    import '../scripts/animations.js';
  </script>
</Layout>
