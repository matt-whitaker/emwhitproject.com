---
import Layout from '../../../layouts/Layout.astro';
import site from '../../../site.config.json';
import { getCollection, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const tracks = await getCollection('tracks');
  return Promise.all(
    tracks.map(async track => {
      const [albumId, trackId] = track.id.split('/');
      return {
        params: { album: albumId, track: trackId },
        props: { track, album: await getEntry('albums', albumId) },
      };
    })
  );
}

const { track, album } = Astro.props;
const { Content } = await render(track);
---

<Layout title={`${track.data.title} — ${album.data.title} — ${site.title}`}>
  <main class="pt-32 pb-24 px-[8vw] max-w-4xl mx-auto text-white">

    <a
      href={`/discography/${album.id}/`}
      class="inline-flex items-center gap-2 text-sm opacity-50 hover:opacity-100 transition-opacity mb-12"
    >
      <i class="fa-solid fa-arrow-left"></i> {album.data.title}
    </a>

    <article>
      <header class="mb-12">
        <span class="block text-xs opacity-50 mb-3">Track {track.data.track} &mdash; {album.data.title}</span>
        <h1 class="font-stardos text-red text-5xl leading-tight mb-4">{track.data.title}</h1>
      </header>

      <div class="prose prose-invert prose-lg leading-body max-w-none opacity-85">
        <Content />
      </div>
    </article>

  </main>
</Layout>
