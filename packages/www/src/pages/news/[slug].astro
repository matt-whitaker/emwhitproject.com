---
import Layout from '../../layouts/Layout.astro';
import site from '../../site.config.json';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const news = await getCollection('news');
  return news.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={`${entry.data.title} — ${site.title}`}>
  <main class="pt-32 pb-24 px-[8vw] max-w-4xl mx-auto text-white">

    <a href="/" class="inline-flex items-center gap-2 text-sm opacity-50 hover:opacity-100 transition-opacity mb-12">
      <i class="fa-solid fa-arrow-left"></i> Back
    </a>

    <article>
      <header class="mb-12">
        <time class="block text-xs opacity-50 mb-3">
          {entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
        </time>
        <h1 class="font-stardos text-red text-5xl leading-tight mb-4">{entry.data.title}</h1>
      </header>

      <div class="prose prose-invert prose-lg leading-body max-w-none opacity-85">
        <Content />
      </div>
    </article>

  </main>
</Layout>
